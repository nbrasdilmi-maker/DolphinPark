# ===== DolphinPark env template (NAMES ONLY - safe to commit) =====
# Copy to .env.local and fill real values. NEVER commit .env.local.

# --- Local PostgreSQL (development) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/DB"
DB_PROVIDER="postgres"

# --- Cloud Supabase Postgres (deploy time only) ---
CLOUD_DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
CLOUD_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Local SQL Server (currently unused) ---
SQLSERVER_URL="sqlserver://HOST:PORT;database=DB;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"

# --- Admin auth ---
ADMIN_JWT_SECRET="CHANGE_ME_long_random_string"
ADMIN_SESSION_DAYS="7"

# --- ImageKit (media cloud) ---
IMAGEKIT_PUBLIC_KEY="CHANGE_ME"
IMAGEKIT_PRIVATE_KEY="CHANGE_ME"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/CHANGE_ME"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/CHANGE_ME"

# --- Supabase realtime (public client) ---
NEXT_PUBLIC_SUPABASE_URL="https://CHANGE_ME.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="CHANGE_ME"
